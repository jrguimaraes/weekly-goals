datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  goals       Goal[]

  @@map("categories")
}

enum WeekStatus {
  DRAFT
  ACTIVE
  CLOSED
}

model Week {
  id        String      @id @default(uuid())
  startDate DateTime    @db.Date
  endDate   DateTime    @db.Date
  status    WeekStatus  @default(DRAFT)
  closedAt  DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  goals     Goal[]
  report    WeekReport?

  @@map("weeks")
}

enum GoalType {
  BINARY
  QUANTITY
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
}

enum GoalStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model Goal {
  id           String       @id @default(uuid())
  weekId       String
  categoryId   String
  title        String
  description  String?
  type         GoalType
  priority     GoalPriority @default(MEDIUM)
  targetValue  Float
  currentValue Float        @default(0)
  status       GoalStatus   @default(PENDING)
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  week     Week     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([weekId])
  @@index([categoryId])
  @@map("goals")
}

model WeekReport {
  id          String   @id @default(uuid())
  weekId      String   @unique
  version     Int      @default(1)
  snapshot    Json
  generatedAt DateTime @default(now())

  week Week @relation(fields: [weekId], references: [id], onDelete: Cascade)

  @@map("week_reports")
}
